logger:
  file:
    path: /var/log/open5gs/amf.log
global:
  max:
    ue: 1024
amf:
  sbi:
    server:
      - address: 127.0.0.5
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.200:7777
  ngap:
    server:
      - address: __HOME_IP__
  metrics:
    server:
      - address: 127.0.0.5
        port: 9090
  guami:
    - plmn_id:
        mcc: '__HOME_MCC__'
        mnc: '__HOME_MNC__'
      amf_id:
        region: 2
        set: 1
  tai:
    - plmn_id:
        mcc: '__HOME_MCC__'
        mnc: '__HOME_MNC__'
      tac: __HOME_TAC__
  plmn_support:
    - plmn_id:
        mcc: '__HOME_MCC__'
        mnc: '__HOME_MNC__'
      s_nssai:
        - sst: __SST__
  security:
    integrity_order: [NIA2, NIA1, NIA0]
    ciphering_order: [NEA0, NEA1, NEA2]
  network_name:
    full: Open5GS
    short: Lab
  amf_name: open5gs-amf0
