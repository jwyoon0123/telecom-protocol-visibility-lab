logger:
  file:
    path: /var/log/open5gs/upf.log
global:
  max:
    ue: 1024
upf:
  pfcp:
    server:
      - address: 127.0.0.7
    client: null
  gtpu:
    server:
      - address: __PARTNER_IP__
  session:
    - subnet: __PARTNER_UE_SUBNET__
      gateway: __PARTNER_UE_GATEWAY__
      dnn: __DNN__
  metrics:
    server:
      - address: 127.0.0.7
        port: 9090
